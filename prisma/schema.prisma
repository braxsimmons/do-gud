generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  username      String    @unique
  name          String
  bio           String    @default("")
  avatar        String
  passwordHash  String
  role          String    @default("user") // "user" | "admin"
  banned        Boolean   @default(false)
  acceptedTosAt DateTime?
  joinedAt      DateTime  @default(now())

  prompts       Prompt[]
  responses     Response[]
  drops         ReflectionDrop[] @relation("DropCreator")
  dropsSent     DropReflection[] @relation("DropSender")
  dropsReceived DropReflection[] @relation("DropRecipient")

  verificationTokens VerificationToken[]
  reportsFiled       Report[] @relation("Reporter")
  blocksMade         Block[]  @relation("Blocker")
  blocksAgainst      Block[]  @relation("Blocked")

  @@index([username])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  purpose   String   @default("email_verification") // email_verification | guest_claim
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Prompt {
  id        String     @id @default(cuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question  String
  category  String
  image     String?
  removed   Boolean    @default(false)
  createdAt DateTime   @default(now())

  responses Response[]

  @@index([authorId])
  @@index([createdAt])
}

model Response {
  id          String   @id @default(cuid())
  promptId    String
  prompt      Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  responderId String?
  responder   User?    @relation(fields: [responderId], references: [id], onDelete: SetNull)
  guestName   String?
  guestEmail  String?
  text        String
  traits      String[]
  anonymous   Boolean  @default(false)
  pinned      Boolean  @default(false)
  removed     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([promptId])
  @@index([responderId])
  @@index([createdAt])
}

model ReflectionDrop {
  id          String   @id @default(cuid())
  prompt      String
  opensAt     DateTime
  closesAt    DateTime
  createdById String?
  createdBy   User?    @relation("DropCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  reflections DropReflection[]

  @@index([opensAt])
  @@index([closesAt])
}

model DropReflection {
  id          String         @id @default(cuid())
  dropId      String
  drop        ReflectionDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User           @relation("DropSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User           @relation("DropRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text        String
  traits      String[]
  pinned      Boolean        @default(false)
  removed     Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([dropId, senderId, recipientId])
  @@index([dropId])
  @@index([senderId])
  @@index([recipientId])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String    // "response" | "prompt" | "drop_reflection" | "user"
  targetId   String
  reason     String    // "spam" | "hateful" | "harassment" | "sexual" | "other"
  detail     String?
  status     String    @default("pending") // "pending" | "actioned" | "dismissed"
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model RateLimit {
  bucket  String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
